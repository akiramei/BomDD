#!/bin/sh
# BomDD process-core commit-msg(harness ECO-015)— fail-closed
# 台帳の状態遷移コミットに lifecycle trailer(BomDD-ECO-Fix / BomDD-ECO-Accept)を要求する。
root=$(git rev-parse --show-toplevel) || exit 1
profile="$root/bomdd/process-profile.yaml"
if [ ! -f "$profile" ]; then
  # ECO-016 案a: HEAD に profile が実在するなら削除中も検査を継続(撤去も ECO 経由)
  # ECO-119 round 6: index にだけある profile(R8-5-05)と、merge の途中(R8-5-03: 結果が欄を落とすかは validator が
  # git だけで照合する — 照合が無ければ validator は素通しで exit 0)でも validator を起動する
  git cat-file -e HEAD:bomdd/process-profile.yaml 2>/dev/null \
    || git cat-file -e :bomdd/process-profile.yaml 2>/dev/null \
    || git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1 \
    || exit 0
fi
v="$root/bomdd/tools/process-validator.py"
py=""
for c in python3 python; do
  if command -v "$c" >/dev/null 2>&1 && "$c" -c "import yaml" >/dev/null 2>&1; then
    py="$c"; break
  fi
done
if [ ! -f "$v" ] || [ -z "$py" ]; then
  echo "process-core: validator または実行可能な python が見つからない — fail-closed で commit を遮断します" >&2
  exit 1
fi
exec "$py" "$v" --mode commit-msg --msg-file "$1"
