#!/bin/sh
# BomDD process-core pre-commit(harness ECO-015)— fail-closed
# 保護パスの変更に open ECO を要求し、台帳の状態遷移を検査する。
# validator/python が見つからない場合、profile が存在する限り commit を遮断する
# (設備喪失は停止が正。無効化するには bomdd/process-profile.yaml を撤去する)。
root=$(git rev-parse --show-toplevel) || exit 1
profile="$root/bomdd/process-profile.yaml"
[ -f "$profile" ] || exit 0
v="$root/bomdd/tools/process-validator.py"
# python3 → python の順で「実際に実行できる」個体を選ぶ(Windows のストアスタブ
# python3.exe は command -v に載るが実行できない — 実行検査で弾く)
py=""
for c in python3 python; do
  if command -v "$c" >/dev/null 2>&1 && "$c" -c "import yaml" >/dev/null 2>&1; then
    py="$c"; break
  fi
done
if [ ! -f "$v" ] || [ -z "$py" ]; then
  echo "process-core: validator または実行可能な python が見つからない — fail-closed で commit を遮断します" >&2
  echo "  復旧: bomdd/tools/process-validator.py と python を配置してください" >&2
  echo "  無効化: bomdd/process-profile.yaml を撤去(管理下宣言の解除)" >&2
  exit 1
fi
exec "$py" "$v" --mode pre-commit
