{"examples": [
 {"id": "EX-01", "title": "起動直後は取り消しもやり直しも使えず、保存済み",
  "basis": "cad/start-screen.json(観測値そのもの)・REQ-012(履歴は編集で積まれる。起動直後は編集なし)",
  "steps": [
   {"action": null,
    "expect": {"undo_enabled": false, "redo_enabled": false, "unsaved": false, "region_count": 4, "trim_start": 6, "trim_end": 132,
               "output_length": 142, "playhead": 20, "selected_start": 6, "selected_end": 40, "selected_speed": 1,
               "selected_volume_percent": 100, "split_enabled": true, "merge_enabled": false, "trim_in_enabled": true,
               "trim_out_enabled": false, "out_fps": 30, "out_width": 1920, "out_height": 1080},
    "unresolved": []}
  ]},
 {"id": "EX-02", "title": "分割 → 取り消し → やり直し(1 段の往復)",
  "basis": "REQ-012(取り消し/やり直し)・REQ-004(再生ヘッドで分割・設定を継承・0.5 s 未満は拒否)・REQ-003(境界の瞬間は後ろの区間)・REQ-007(In の可否)・REQ-011(出力長)・REQ-013(出力 fps=ソース fps=30)・README History",
  "steps": [
   {"action": "Split",
    "expect": {"region_count": 5, "output_length": 142, "playhead": 20, "trim_start": 6, "trim_end": 132,
               "undo_enabled": true, "redo_enabled": false, "split_enabled": false, "trim_in_enabled": false,
               "trim_out_enabled": false, "unsaved": true},
    "unresolved": ["selected_start", "selected_end", "merge_enabled"]},
   {"action": "Undo",
    "expect": {"region_count": 4, "output_length": 142, "playhead": 20, "trim_start": 6, "trim_end": 132,
               "selected_start": 6, "selected_end": 40, "selected_speed": 1, "selected_volume_percent": 100,
               "undo_enabled": false, "redo_enabled": true, "split_enabled": true, "merge_enabled": false,
               "trim_in_enabled": true, "trim_out_enabled": false},
    "unresolved": ["unsaved"]},
   {"action": "Redo",
    "expect": {"region_count": 5, "output_length": 142, "playhead": 20, "undo_enabled": true, "redo_enabled": false,
               "split_enabled": false, "trim_in_enabled": false, "trim_out_enabled": false, "unsaved": true},
    "unresolved": ["selected_start", "selected_end", "merge_enabled"]}
  ]},
 {"id": "EX-03", "title": "取り消しのあとに新しい編集をすると、やり直しが消える",
  "basis": "REQ-012「a new edit clears the redo steps」・REQ-008(速度)・REQ-004",
  "steps": [
   {"action": "Split", "expect": {"region_count": 5, "undo_enabled": true, "redo_enabled": false}, "unresolved": []},
   {"action": "Undo", "expect": {"region_count": 4, "undo_enabled": false, "redo_enabled": true, "selected_start": 6, "selected_end": 40}, "unresolved": []},
   {"action": "ApplySpeedPreset:2",
    "expect": {"region_count": 4, "selected_start": 6, "selected_end": 40, "selected_speed": 2, "undo_enabled": true, "redo_enabled": false, "unsaved": true},
    "unresolved": ["output_length"]},
   {"action": "Undo",
    "expect": {"region_count": 4, "selected_speed": 1, "output_length": 142, "undo_enabled": false, "redo_enabled": true},
    "unresolved": ["unsaved"]},
   {"action": "Redo",
    "expect": {"region_count": 4, "selected_speed": 2, "undo_enabled": true, "redo_enabled": false, "unsaved": true},
    "unresolved": ["output_length"]}
  ]},
 {"id": "EX-04", "title": "再生ヘッドの移動は編集ではないので、やり直しを消さない",
  "basis": "REQ-012(新しい「編集」がやり直しを消す)・README Design notes(履歴は不変ドキュメントのスナップショット。再生ヘッドはドキュメントの外)・README Shortcuts(←/→ = 1 フレーム)・REQ-013(fps 30)",
  "steps": [
   {"action": "Split", "expect": {"region_count": 5, "undo_enabled": true}, "unresolved": []},
   {"action": "Undo", "expect": {"region_count": 4, "undo_enabled": false, "redo_enabled": true, "playhead": 20}, "unresolved": []},
   {"action": "StepForward",
    "expect": {"playhead": 20.033, "region_count": 4, "undo_enabled": false, "redo_enabled": true, "selected_start": 6, "selected_end": 40},
    "unresolved": []},
   {"action": "Redo",
    "expect": {"region_count": 5, "playhead": 20.033, "output_length": 142, "undo_enabled": true, "redo_enabled": false,
               "split_enabled": false, "trim_in_enabled": false, "unsaved": true},
    "unresolved": ["selected_start", "selected_end", "merge_enabled"]}
  ]},
 {"id": "EX-05", "title": "2 つの編集を逆順に取り消し、順に戻す(速度と音量)",
  "basis": "REQ-012(複数段の取り消し/やり直し)・REQ-008(速度)・REQ-009(音量)",
  "steps": [
   {"action": "ApplySpeedPreset:2",
    "expect": {"selected_speed": 2, "selected_volume_percent": 100, "undo_enabled": true, "redo_enabled": false, "unsaved": true},
    "unresolved": ["output_length"]},
   {"action": "ApplyVolumePreset:50",
    "expect": {"selected_speed": 2, "selected_volume_percent": 50, "undo_enabled": true, "redo_enabled": false},
    "unresolved": ["output_length"]},
   {"action": "Undo",
    "expect": {"selected_speed": 2, "selected_volume_percent": 100, "undo_enabled": true, "redo_enabled": true, "unsaved": true},
    "unresolved": ["output_length"]},
   {"action": "Undo",
    "expect": {"selected_speed": 1, "selected_volume_percent": 100, "output_length": 142, "undo_enabled": false, "redo_enabled": true},
    "unresolved": ["unsaved"]},
   {"action": "Redo",
    "expect": {"selected_speed": 2, "selected_volume_percent": 100, "undo_enabled": true, "redo_enabled": true, "unsaved": true},
    "unresolved": ["output_length"]},
   {"action": "Redo",
    "expect": {"selected_speed": 2, "selected_volume_percent": 50, "undo_enabled": true, "redo_enabled": false, "unsaved": true},
    "unresolved": ["output_length"]}
  ]},
 {"id": "EX-06", "title": "トリム開始(In)の取り消しとやり直し",
  "basis": "REQ-007(In は再生ヘッドへ・最初の区間の開始も動く・可否条件)・REQ-004(縁から 0.5 s 未満は分割不可)・REQ-012",
  "steps": [
   {"action": "SetTrimIn",
    "expect": {"trim_start": 20, "trim_end": 132, "selected_start": 20, "selected_end": 40, "region_count": 4, "playhead": 20,
               "undo_enabled": true, "redo_enabled": false, "split_enabled": false, "merge_enabled": false,
               "trim_in_enabled": true, "trim_out_enabled": false, "unsaved": true},
    "unresolved": ["output_length"]},
   {"action": "Undo",
    "expect": {"trim_start": 6, "selected_start": 6, "selected_end": 40, "output_length": 142, "region_count": 4, "playhead": 20,
               "undo_enabled": false, "redo_enabled": true, "split_enabled": true, "trim_in_enabled": true},
    "unresolved": ["unsaved"]},
   {"action": "Redo",
    "expect": {"trim_start": 20, "selected_start": 20, "selected_end": 40, "playhead": 20, "undo_enabled": true, "redo_enabled": false,
               "split_enabled": false, "unsaved": true},
    "unresolved": ["output_length"]}
  ]},
 {"id": "EX-07", "title": "In・速度・ミュートの 3 段を全部取り消し、全部やり直す",
  "basis": "REQ-012・REQ-007・REQ-008・REQ-009(0 = ミュート)",
  "steps": [
   {"action": "SetTrimIn", "expect": {"trim_start": 20, "selected_start": 20, "undo_enabled": true, "redo_enabled": false}, "unresolved": []},
   {"action": "ApplySpeedPreset:0.5", "expect": {"trim_start": 20, "selected_speed": 0.5, "undo_enabled": true, "redo_enabled": false}, "unresolved": ["output_length"]},
   {"action": "ApplyVolumePreset:0", "expect": {"selected_speed": 0.5, "selected_volume_percent": 0, "undo_enabled": true, "redo_enabled": false}, "unresolved": ["output_length"]},
   {"action": "Undo", "expect": {"trim_start": 20, "selected_speed": 0.5, "selected_volume_percent": 100, "undo_enabled": true, "redo_enabled": true}, "unresolved": []},
   {"action": "Undo", "expect": {"trim_start": 20, "selected_start": 20, "selected_speed": 1, "selected_volume_percent": 100, "undo_enabled": true, "redo_enabled": true}, "unresolved": ["output_length"]},
   {"action": "Undo",
    "expect": {"trim_start": 6, "selected_start": 6, "selected_end": 40, "selected_speed": 1, "selected_volume_percent": 100,
               "output_length": 142, "undo_enabled": false, "redo_enabled": true},
    "unresolved": ["unsaved"]},
   {"action": "Redo", "expect": {"trim_start": 20, "selected_start": 20, "selected_speed": 1, "undo_enabled": true, "redo_enabled": true, "unsaved": true}, "unresolved": []},
   {"action": "Redo", "expect": {"trim_start": 20, "selected_speed": 0.5, "selected_volume_percent": 100, "undo_enabled": true, "redo_enabled": true}, "unresolved": []},
   {"action": "Redo", "expect": {"trim_start": 20, "selected_speed": 0.5, "selected_volume_percent": 0, "undo_enabled": true, "redo_enabled": false, "unsaved": true}, "unresolved": ["output_length"]}
  ]},
 {"id": "EX-08", "title": "コマ送り・コマ戻しだけでは取り消しが使えるようにならない",
  "basis": "README Design notes(履歴はドキュメントのスナップショット)・README Shortcuts(1 フレーム)・REQ-013(fps 30)・REQ-003",
  "steps": [
   {"action": "StepForward",
    "expect": {"playhead": 20.033, "undo_enabled": false, "redo_enabled": false, "unsaved": false, "region_count": 4,
               "selected_start": 6, "selected_end": 40},
    "unresolved": []},
   {"action": "StepBack",
    "expect": {"playhead": 20, "undo_enabled": false, "redo_enabled": false, "unsaved": false, "region_count": 4},
    "unresolved": []}
  ]},
 {"id": "EX-09", "title": "出力 fps の変更は履歴に積まれるか(資料から決まらない)",
  "basis": "REQ-012(「every edit」)・REQ-013 と UQ-REQ-013-001(fps と出力サイズは元アプリでは画面の view model にあり、ドキュメントの外)",
  "steps": [
   {"action": "Split", "expect": {"region_count": 5, "undo_enabled": true, "redo_enabled": false}, "unresolved": []},
   {"action": "SetFps:60", "expect": {"out_fps": 60, "region_count": 5, "undo_enabled": true, "redo_enabled": false}, "unresolved": []},
   {"action": "Undo", "expect": {"redo_enabled": true}, "unresolved": ["out_fps", "region_count", "undo_enabled"]}
  ]},
 {"id": "EX-10", "title": "出力サイズのプリセットは履歴に積まれるか(資料から決まらない)",
  "basis": "REQ-013(プリセットはソースサイズから・偶数化)・UQ-REQ-013-001・REQ-012",
  "steps": [
   {"action": "Split", "expect": {"region_count": 5, "undo_enabled": true}, "unresolved": []},
   {"action": "Scale:0.5", "expect": {"out_width": 960, "out_height": 540, "region_count": 5, "undo_enabled": true, "redo_enabled": false}, "unresolved": []},
   {"action": "Undo", "expect": {"redo_enabled": true}, "unresolved": ["out_width", "out_height", "region_count", "undo_enabled"]}
  ]},
 {"id": "EX-11", "title": "値の変わらない編集(1x のまま 1x を押す)は 1 段になるか",
  "basis": "REQ-008・REQ-012(資料は値が変わらない編集を扱っていない)",
  "steps": [
   {"action": "ApplySpeedPreset:1",
    "expect": {"selected_speed": 1, "output_length": 142, "redo_enabled": false, "region_count": 4},
    "unresolved": ["undo_enabled", "unsaved"]}
  ]},
 {"id": "EX-12", "title": "出力 fps だけを変えたとき、取り消しと保存状態はどうなるか",
  "basis": "REQ-013・UQ-REQ-013-001・REQ-012",
  "steps": [
   {"action": "SetFps:24",
    "expect": {"out_fps": 24, "region_count": 4, "output_length": 142, "redo_enabled": false},
    "unresolved": ["undo_enabled", "unsaved"]}
  ]}
]}
