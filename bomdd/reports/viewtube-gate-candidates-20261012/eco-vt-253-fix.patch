+#!/usr/bin/env python3
+"""ECO-VT-253 equivalence: the original and the repaired pre-commit hook return the same verdict.
+
+ORIGINAL is bomdd/hooks/pre-commit at --original-rev (default 9c129eac, the commit before the
+repair); REPAIRED is the working tree's. For each staged state, a fresh throwaway clone
+(`git clone --shared -c core.autocrlf=false` into the system temp directory; nothing is written to
+this tree) runs each hook once and the exit code and stdout are compared byte for byte. Temporary
+directory names are masked. Run from the repository root:
+
+  python test-results/eco-vt-253-the-hook-copies-the-whole-index-to-run-one-validator/equiv253.py [--original-rev REV]
+
+  S1  the register only (a record commit)                                     - PASS expected
+  S2  the register and an ECO body                                            - PASS expected
+  S3  ECO-VT-253's manifest without its independent_review field              - blocked expected
+  S4  ECO-VT-253's manifest emptied of its semantic ids                       - blocked expected
+  (--states S3,S6 runs only the named states; mutants253.py uses it)
+  S5  change-impact equipment staged (the policy): the whole copy and the trusted harness run in both
+  S6  the register staged and the validator broken in the WORKING TREE only - the index copy must run
+
+Exit 0 when every state gives the same exit code and stdout, 1 otherwise.
+"""
+import datetime
+import hashlib
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+ROOT = Path.cwd()
+ORIGINAL_REV = "9c129eac"
+ONLY = sys.argv[sys.argv.index("--states") + 1].split(",") if "--states" in sys.argv else []
+if "--original-rev" in sys.argv:
+    ORIGINAL_REV = sys.argv[sys.argv.index("--original-rev") + 1]
+for stream in (sys.stdout, sys.stderr):
+    stream.reconfigure(encoding="utf-8", errors="backslashreplace")
+started = datetime.datetime.now().astimezone()
+print(f"started_at {started.isoformat(timespec='seconds')}")
+original = subprocess.run(["git", "show", f"{ORIGINAL_REV}:bomdd/hooks/pre-commit"], cwd=ROOT,
+                          capture_output=True, check=True).stdout
+repaired = (ROOT / "bomdd" / "hooks" / "pre-commit").read_bytes()
+print(f"ORIGINAL {ORIGINAL_REV} sha256 {hashlib.sha256(original).hexdigest()}")
+print(f"REPAIRED working tree sha256 {hashlib.sha256(repaired).hexdigest()}")
+if original == repaired:
+    print("REFUSED: ORIGINAL and REPAIRED are the same bytes; nothing would be compared")
+    raise SystemExit(1)
+
+# THE KNOWN-BAD STATES BREAK AN ACTIVE ECO'S MANIFEST. The first run broke ECO-VT-252's, which is
+# applied: validate_process refused it as UNREGISTERED_PROTECTED_CHANGE before the hook reached the
+# change-impact step, so S3 and S4 never exercised the step this ECO changes. ECO-VT-253 is staged
+# and declares its own manifest, so a broken one reaches validate_change_impact.
+MANIFEST = "bomdd/process/change-impact/ECO-VT-253.yaml"
+
+
+def stage_s1(clone):
+    path = clone / "bomdd/process/change-register.yaml"
+    path.write_bytes(path.read_bytes() + b"# equiv253\n")
+    return ["bomdd/process/change-register.yaml"]
+
+
+def stage_s2(clone):
+    body = clone / "bomdd/eco/ECO-VT-252.md"
+    body.write_bytes(body.read_bytes() + b"\nequiv253\n")
+    return stage_s1(clone) + ["bomdd/eco/ECO-VT-252.md"]
+
+
+def stage_s3(clone):
+    path = clone / MANIFEST
+    text = path.read_bytes()
+    assert b"\nindependent_review:\n" in text
+    path.write_bytes(text.replace(b"\nindependent_review:\n", b"\nindependent_review_removed:\n", 1))
+    return [MANIFEST]
+
+
+def stage_s4(clone):
+    path = clone / MANIFEST
+    text = path.read_bytes()
+    new = re.sub(rb"changed_semantic_ids:\n(- [^\n]*\n)+", b"changed_semantic_ids: []\n", text, count=1)
+    assert new != text
+    text = new
+    path.write_bytes(text)
+    return [MANIFEST]
+
+
+def stage_s5(clone):
+    path = clone / "bomdd/process/change-impact-policy.yaml"
+    path.write_bytes(path.read_bytes() + b"# equiv253\n")
+    return ["bomdd/process/change-impact-policy.yaml"]
+
+
+def stage_s6(clone):
+    # The register staged, and the change-impact validator broken IN THE WORKING TREE ONLY (not
+    # staged). The hook must run the validator as the index holds it, so both hooks pass; a copy
+    # taken from the working tree would run the broken one.
+    validator = clone / "bomdd/tools/validate_change_impact.py"
+    validator.write_bytes(b"raise SystemExit('equiv253: the working-tree copy ran')\n")
+    return stage_s1(clone)
+
+
+def run(hook, stage):
+    base = Path(tempfile.mkdtemp(prefix="eco253eq-"))
+    clone = base / "clone"
+    try:
+        subprocess.run(["git", "clone", "-q", "--shared", "-c", "core.autocrlf=false", str(ROOT), str(clone)],
+                       check=True)
+        # S5 stages the policy, which makes the trusted harness qualify the hook in the copy; the
+        # hook under test is written in place and kept out of the staged set.
+        (clone / "bomdd/hooks/pre-commit").write_bytes(hook)
+        subprocess.run(["git", "-C", str(clone), "update-index", "--assume-unchanged",
+                        "bomdd/hooks/pre-commit"], check=True)
+        for rel in stage(clone):
+            subprocess.run(["git", "-C", str(clone), "add", rel], check=True)
+        done = subprocess.run(["bash", "bomdd/hooks/pre-commit"], cwd=clone, capture_output=True)
+        out = done.stdout.decode("utf-8", "replace")
+        out = re.sub(r"/tmp/tmp\.[A-Za-z0-9]+", "<TMP>", out)
+        out = out.replace(str(clone), "<CLONE>").replace(clone.as_posix(), "<CLONE>")
+        return done.returncode, out
+    finally:
+        shutil.rmtree(base, ignore_errors=True)
+
+
+results = []
+for label, stage in (("S1 the register only", stage_s1), ("S2 the register and an ECO body", stage_s2),
+                     ("S3 an active manifest without its independent_review field (known-bad)", stage_s3),
+                     ("S4 an active manifest without semantic ids (known-bad)", stage_s4),
+                     ("S5 change-impact equipment staged", stage_s5),
+                     ("S6 the validator broken in the working tree only", stage_s6)):
+    if ONLY and label.split()[0] not in ONLY:
+        continue
+    a = run(original, stage)
+    b = run(repaired, stage)
+    same = a == b
+    results.append(same)
+    last = [line for line in a[1].splitlines() if "ERROR" in line or "blocked" in line][:1] or \
+        [a[1].strip().splitlines()[-1] if a[1].strip() else ""]
+    print(f"[{'SAME' if same else 'DIFFERENT'}] {label} | rc {a[0]}/{b[0]}, stdout {len(a[1])}/{len(b[1])} chars | {last[0][:110]}")
+    if not same:
+        for line_a, line_b in zip(a[1].splitlines(), b[1].splitlines()):
+            if line_a != line_b:
+                print(f"    first difference:\n    - {line_a[:160]}\n    + {line_b[:160]}")
+                break
+
+finished = datetime.datetime.now().astimezone()
+print(f"finished_at {finished.isoformat(timespec='seconds')} "
+      f"elapsed_ms {int((finished - started).total_seconds() * 1000)}")
+print(f"RESULT {'SAME' if all(results) else 'DIFFERENT'} ({sum(results)}/{len(results)} states same)")
+raise SystemExit(0 if all(results) else 1)
