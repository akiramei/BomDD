+#!/usr/bin/env python3
+"""ECO-VT-253 mutants: do the probe and the equivalence check go red when the repair is broken?
+
+Each mutant edits the working tree's bomdd/hooks/pre-commit in a temporary copy of this script's
+inputs - the working tree itself is NOT written: the mutated hook is handed to probe253.py and
+equiv253.py through a throwaway directory that mirrors the repository root (the scripts read the
+hook from `<cwd>/bomdd/hooks/pre-commit`, so they are run with cwd at a throwaway clone whose hook is
+the mutant). A mutant is KILLED when the probe or the equivalence check exits 1. Run from the
+repository root:
+
+  python test-results/eco-vt-253-the-hook-copies-the-whole-index-to-run-one-validator/mutants253.py
+"""
+import datetime
+import hashlib
+import shutil
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+ROOT = Path.cwd()
+HERE = Path(__file__).resolve().parent
+HOOK = ROOT / "bomdd" / "hooks" / "pre-commit"
+NARROW = ("    git ls-files -z -- bomdd/tools bomdd/process/change-impact-policy.yaml \\\n"
+          "      | git checkout-index -z --stdin --prefix=\"$TMP_IMPACT_TREE/\"\n")
+BRANCH = "  if [ \"$IMPACT_EQUIPMENT\" -eq 0 ]; then\n    git checkout-index --all --prefix=\"$TMP_IMPACT_TREE/\"\n"
+
+MUTANTS = [
+    ("K1 the narrowed copy is used for equipment commits too",
+     [(BRANCH, "  if false; then\n    git checkout-index --all --prefix=\"$TMP_IMPACT_TREE/\"\n")], "probe"),
+    ("K2 the narrowed copy leaves out the change-impact policy",
+     [(NARROW, "    git ls-files -z -- bomdd/tools \\\n"
+               "      | git checkout-index -z --stdin --prefix=\"$TMP_IMPACT_TREE/\"\n")], "probe"),
+    # NOT A MUTANT: copying the validator and the two presence-checked files without the rest of
+    # bomdd/tools/ gives the same verdict, because the validator imports nothing from its folder.
+    # Copying the whole folder is the conservative superset (an import could resolve there); it is
+    # not something the checks can tell apart, and it is recorded as such rather than "killed".
+    ("K4 the narrowed copy is taken from the working tree, not the index",
+     [(NARROW, "    mkdir -p \"$TMP_IMPACT_TREE/bomdd/process\" && cp -r bomdd/tools \"$TMP_IMPACT_TREE/bomdd/\""
+               " && cp bomdd/process/change-impact-policy.yaml \"$TMP_IMPACT_TREE/bomdd/process/\"\n")], "equiv"),
+]
+
+
+def main() -> int:
+    for stream in (sys.stdout, sys.stderr):
+        stream.reconfigure(encoding="utf-8", errors="backslashreplace")
+    started = datetime.datetime.now().astimezone()
+    print(f"started_at {started.isoformat(timespec='seconds')}")
+    head = subprocess.run(["git", "rev-parse", "HEAD"], cwd=ROOT, capture_output=True, text=True).stdout.strip()
+    source = HOOK.read_bytes().decode("utf-8")
+    print(f"HEAD {head}")
+    print(f"sha256 {hashlib.sha256(HOOK.read_bytes()).hexdigest()}  bomdd/hooks/pre-commit (working tree, the source every mutant edits)")
+    killed_all = True
+    for label, edits, check in MUTANTS:
+        mutant = source
+        missing = [old for old, _ in edits if mutant.count(old) != 1]
+        if missing:
+            print(f"[NOT APPLIED] {label}: an anchor does not occur exactly once: {missing[0][:70]!r}")
+            killed_all = False
+            continue
+        for old, new in edits:
+            mutant = mutant.replace(old, new)
+        base = Path(tempfile.mkdtemp(prefix="eco253mu-"))
+        stage_root = base / "root"
+        try:
+            # A throwaway clone as the "repository root" the check scripts read the hook from. Its
+            # HEAD is this tree's HEAD, so equiv253's --original-rev resolves the same way.
+            subprocess.run(["git", "clone", "-q", "--shared", "-c", "core.autocrlf=false", str(ROOT),
+                            str(stage_root)], check=True)
+            (stage_root / "bomdd/hooks/pre-commit").write_bytes(mutant.encode("utf-8"))
+            script = HERE / ("probe253.py" if check == "probe" else "equiv253.py")
+            extra = [] if check == "probe" else ["--states", "S6"]   # the state that reads the index
+            done = subprocess.run([sys.executable, str(script), *extra], cwd=stage_root, capture_output=True,
+                                  text=True, encoding="utf-8", errors="replace")
+        finally:
+            shutil.rmtree(base, ignore_errors=True)
+        red = [line.split("|")[0].strip() for line in done.stdout.splitlines()
+               if ": RED" in line or line.startswith("[DIFFERENT]")]
+        killed = done.returncode == 1 and bool(red)
+        killed_all = killed_all and killed
+        print(f"[{'KILLED' if killed else 'SURVIVED'}] {label} | {check} exit {done.returncode}, red in {red or 'none'}")
+    finished = datetime.datetime.now().astimezone()
+    print(f"finished_at {finished.isoformat(timespec='seconds')} "
+          f"elapsed_ms {int((finished - started).total_seconds() * 1000)}")
+    print(f"RESULT {'ALL KILLED' if killed_all else 'NOT ALL KILLED'}")
+    return 0 if killed_all else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
