<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BomDD.WebApiSample.Acceptance</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BomDD.WebApiSample.Core\BomDD.WebApiSample.Core.csproj" />
    <!-- Build-order dependency only: the harness launches the API as a separate process for the L1/L3 depths. -->
    <ProjectReference Include="..\..\src\BomDD.WebApiSample.Api\BomDD.WebApiSample.Api.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
